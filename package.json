{
  "name": "color-recipe",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Lunaneco",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lunaneco/Colot-recipe.git"
  },
  "bugs": {
    "url": "https://github.com/Lunaneco/Colot-recipe/issues"
  },
  "homepage": "https://lunaneco.github.io/Colot-recipe/",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --base /Colot-recipe/",
    "start": "vite preview --base /Colot-recipe/",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "node --import tsx --test tests/colorScience.test.mjs tests/paintCalibration.test.mjs tests/paintResearchValidation.test.mjs tests/paintEngine.test.mjs tests/savedColorSchema.test.mjs tests/spatialMix.test.mjs tests/storage.test.mjs tests/strokeSampling.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:static": "npm run build && PLAYWRIGHT_STATIC=true playwright test",
    "screenshots": "node tests/capture-screenshots.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist"
  },
  "dependencies": {
    "lucide-react": "^1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0"
  },
  "overrides": {
    "postcss": "8.5.24"
  },
  "type": "module"
}
